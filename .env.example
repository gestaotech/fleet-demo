# Desenvolvimento local e funções da Vercel
# Copie para .env.local apenas no computador local. Nunca comite valores reais.

# String de conexão do Neon (PostgreSQL). Use a pooled connection string para a aplicação.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-POOL.neon.tech/NEON_DATABASE?sslmode=require"

# Segredo aleatório para futuras sessões de autenticação no servidor.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES"

# Opcional: segredo dedicado para anonimizar IPs em logs.
IP_HASH_SALT="SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO"
