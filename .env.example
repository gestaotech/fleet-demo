# Copie este arquivo para .env ou .env.local e preencha valores locais.
# Nunca comite segredos ou URLs com credenciais reais.

# PostgreSQL da aplicação. Use um banco local/de desenvolvimento.
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/fleet_demo?schema=public"

# URL direta para migrações Prisma. Pode ser igual a DATABASE_URL em PostgreSQL local.
DIRECT_DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/fleet_demo?schema=public"

# Gere um segredo aleatório; não reutilize em produção.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES"

# Opcional; padrão da aplicação: 8 horas.
SESSION_TTL_HOURS="8"

# Configure somente para testes de integração, em banco separado e descartável.
# Não use banco de produção nem dados reais.
TEST_DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/fleet_demo_test?schema=public"

# Seed desabilitado por padrão. Habilite apenas conscientemente em desenvolvimento.
ALLOW_SEED="false"
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_NAME="Administrador local"
SEED_ADMIN_PASSWORD="SUBSTITUA_POR_UMA_SENHA_FORTE_COM_PELO_MENOS_12_CARACTERES"
SEED_RESET_PASSWORD="false"
