# ---------------------------------------------------------------------------
# Variáveis de ambiente - Sistema de Gestão de Frota (HTML/JS + funções Vercel + Neon)
#
# Copie para .env.local (desenvolvimento local) ou cadastre no painel da Vercel.
# NUNCA coloque credenciais reais neste arquivo nem o versione.
# Os valores abaixo são ilustrativos.
# ---------------------------------------------------------------------------

# Conexão com o Neon PostgreSQL usada pelas funções /api. Obrigatória.
# Use a string com pooling do Neon. Nunca exponha esta variável no navegador.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-exemplo-pooler.sa-east-1.aws.neon.tech/fleet_demo?sslmode=require"

# Opcional: conexão usada apenas por `npm run db:migrate` e `npm run db:seed`.
# Se ausente, usa DATABASE_URL. Pode ser a conexão direta (sem pooler) do Neon.
MIGRATION_DATABASE_URL=""

# Duração da sessão em horas (1 a 720). Padrão: 8.
SESSION_TTL_HOURS="8"

# Segredo usado para anonimizar IPs nos registros (hash com salt). Obrigatório em produção.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IP_HASH_SALT="TROQUE_POR_SEGREDO_ALEATORIO_DE_32_BYTES"

# "true" somente na Vercel, onde o proxy sobrescreve x-forwarded-for. Em outros ambientes mantenha "false".
TRUSTED_PROXY_HEADERS="false"

# Porta do servidor local (npm start). Padrão: 8080.
PORT="8080"

# ---- Seed de dados de exemplo/desenvolvimento (npm run db:seed) ----
# Recusado em produção. Exige ALLOW_SEED=true.
ALLOW_SEED="false"
SEED_COMPANY_NAME="Empresa Exemplo"
SEED_COMPANY_SLUG="empresa-exemplo"
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_NAME="Administrador"
# Mínimo de 10 caracteres. Não existe senha padrão.
SEED_ADMIN_PASSWORD="TROQUE_POR_SENHA_FORTE_DE_NO_MINIMO_10"
# "true" redefine a senha de um administrador já existente (uso consciente).
SEED_RESET_PASSWORD="false"
# "true" substitui os dados operacionais já gravados pelo estado de exemplo.
SEED_RESET_WORKSPACE="false"

# ---- Testes de integração (npm run test:integration) ----
# Banco DESCARTÁVEL, diferente de DATABASE_URL. O schema público é recriado.
TEST_DATABASE_URL="postgresql://USUARIO:SENHA@ep-exemplo-teste.sa-east-1.aws.neon.tech/fleet_demo_teste?sslmode=require"
TEST_DATABASE_RESET="sim"
